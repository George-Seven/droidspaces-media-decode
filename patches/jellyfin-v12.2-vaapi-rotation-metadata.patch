diff --git a/Jellyfin.Api/Controllers/DynamicHlsController.cs b/Jellyfin.Api/Controllers/DynamicHlsController.cs
index 6df76de..99fa515 100644
--- a/Jellyfin.Api/Controllers/DynamicHlsController.cs
+++ b/Jellyfin.Api/Controllers/DynamicHlsController.cs
@@ -1908,6 +1908,17 @@ public class DynamicHlsController : BaseJellyfinApiController
             args += EncodingHelper.GetVideoSyncOption(state.OutputVideoSync, _mediaEncoder.EncoderVersion);
         }
 
+        // VAAPI keeps the source pixels unrotated; store the display transform
+        // in the fMP4 track so compatible HLS players can rotate during playback.
+        if (string.Equals(segmentContainer, "mp4", StringComparison.OrdinalIgnoreCase)
+            && codec.EndsWith("_vaapi", StringComparison.OrdinalIgnoreCase)
+            && _encodingHelper.IsVaapiDecoderEnabled(state, _encodingOptions)
+            && state.VideoStream?.Rotation is int rotation
+            && rotation != 0)
+        {
+            args += " -metadata:s:v:0 rotate=" + rotation.ToString(CultureInfo.InvariantCulture);
+        }
+
         args += _encodingHelper.GetOutputFFlags(state);
 
         return args;
diff --git a/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs b/MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs
