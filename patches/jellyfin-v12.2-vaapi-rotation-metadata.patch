+        /// <summary>
+        /// Determines whether the selected hardware decoder is VAAPI.
+        /// </summary>
+        /// <param name="state">The encoding job info.</param>
+        /// <param name="options">The encoding options.</param>
+        /// <returns>True when FFmpeg will use a VAAPI decoder.</returns>
+        public bool IsVaapiDecoderEnabled(EncodingJobInfo state, EncodingOptions options)
+        {
+            return GetHardwareVideoDecoder(state, options)?.Contains(" -hwaccel vaapi", StringComparison.OrdinalIgnoreCase) == true;
+        }
+
         /// <summary>
         /// Gets a hw decoder name.
         /// </summary>
@@ -6684,9 +6695,17 @@ namespace MediaBrowser.Controller.MediaEncoding
             // Disable the extra internal copy in nvdec. We already handle it in filter chain.
             var nvdecNoInternalCopy = ffmpegVersion >= _minFFmpegHwaUnsafeOutput;
 
-            // Strip the display rotation side data from the transposed fmp4 output stream.
+            // Strip display rotation when the filter path will rotate the pixels.
+            // For VAAPI-to-VAAPI transcoding, retain it for the output track metadata.
+            var preserveVaapiRotation = hardwareAccelerationType == HardwareAccelerationType.vaapi
+                && isVaapiSupported
+                && isCodecAvailable
+                && outputHwSurface
+                && options.EnableHardwareEncoding
+                && GetVideoEncoder(state, options).EndsWith("_vaapi", StringComparison.OrdinalIgnoreCase);
             var stripRotationData = (state.VideoStream?.Rotation ?? 0) != 0
