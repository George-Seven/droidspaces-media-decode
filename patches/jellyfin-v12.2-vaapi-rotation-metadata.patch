+                && ffmpegVersion >= _minFFmpegDisplayRotationOption
+                && !preserveVaapiRotation;
             var stripRotationDataArgs = stripRotationData ? " -display_rotation 0" : string.Empty;
 
             // VideoToolbox decoders have built-in SW fallback
@@ -7849,6 +7868,16 @@ namespace MediaBrowser.Controller.MediaEncoding
                 args += GetVideoSyncOption(state.OutputVideoSync, _mediaEncoder.EncoderVersion);
             }
 
+            // VAAPI encoders keep the source pixel orientation. Tell MP4/fMP4
+            // muxers to retain the source display transform in the output track.
+            if (videoCodec.EndsWith("_vaapi", StringComparison.OrdinalIgnoreCase)
